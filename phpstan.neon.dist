parameters:
    level: max
    paths:
        - src
        - config
        - tests/Fixtures
        - tests/PublicApi
        - workbench
    tmpDir: build/phpstan

    # Pest test files are closures against a reflection API that returns mixed,
    # so they are analysed by running them. The helper classes beside them are
    # ordinary code and stay in scope.
    excludePaths:
        - tests/*/*Test.php

    # This is a package, so Larastan cannot boot an application to discover
    # where config files live. Point it at ours, otherwise every `env()` call in
    # config/assignment.php is reported as being outside the config directory.
    configDirectories:
        - config

    # AssignmentNotification::view() builds the view name at runtime, so
    # PHPStan cannot prove that it is a view-string. The four shipped views
    # exist, and AssignmentNotificationTest renders each one.
    ignoreErrors:
        -
            identifier: argument.type
            message: '#^Parameter \#1 \$view of method Illuminate\\Notifications\\Messages\\MailMessage\:\:markdown\(\) expects view\-string, string given\.$#'
            path: src/Notifications/AssignmentNotification.php
