# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Ignore all test and documentation with "export-ignore".
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/tests              export-ignore
/workbench          export-ignore
/.editorconfig      export-ignore
/testbench.yaml     export-ignore
/phpstan.neon.dist  export-ignore
/pint.json          export-ignore

# Planning documents — useful in the repo, dead weight in a vendor install.
/issues             export-ignore
/.scratch           export-ignore

# Never tracked, so `git archive` drops these anyway. Listing them keeps
# `composer archive`, which reads this file and not `.gitignore`, honest.
/vendor             export-ignore
/build              export-ignore
/.idea              export-ignore
/test-results       export-ignore
/composer.lock      export-ignore
.DS_Store           export-ignore

# Repository governance — useful on GitHub, dead weight in a vendor install.
/CONTRIBUTING.md    export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md        export-ignore
